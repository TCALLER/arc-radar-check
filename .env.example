# Base URL of the check + access API (no trailing slash).
NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# "enabled" → MSW serves the files in samples/ and a mocked /v1/access. "disabled" → real API.
NEXT_PUBLIC_API_MOCKING=enabled

# "enabled" → mocked Telegram user (display name only, never trusted).
NEXT_PUBLIC_AUTH_MOCKING=enabled

# Arc mainnet RPC endpoint. Use your own free endpoint; required, there is no fallback.
NEXT_PUBLIC_ARC_RPC_URL=https://your-arc-rpc-endpoint.example

# Price shown on the pay button of a locked full report (that response has no price), e.g. 0.50.
# Leave empty to show "Pay per check". A 402 response always shows its own price.
NEXT_PUBLIC_CHECK_PRICE_USDC=
